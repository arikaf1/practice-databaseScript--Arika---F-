-- Test foreign key relationships
SELECT 'Books with Author Information:' as Query_Description;
SELECT b.title, b.isbn, a.first_name, a.last_name, b.publication_year
FROM books b
JOIN authors a ON b.author_id = a.author_id;
SELECT 'Active Loans with Book and Author Information:' as
Query_Description;
SELECT l.borrower_name, b.title, a.first_name, a.last_name,
l.loan_date, l.due_date
FROM loans l
JOIN books b ON l.book_id = b.book_id
JOIN authors a ON b.author_id = a.author_id
WHERE l.status = 'active';
